# === Infraestrutura Compartilhada ===
# Apenas conexões e parâmetros usados diretamente pelo worker (main.py).
# Variáveis específicas de cada agente ficam em .env.rsa / .env.sql.

LOG_LEVEL=INFO

# RabbitMQ (conexão; fila é definida no env específico do agente)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Redis (conexão)
REDIS_HOST=redis
REDIS_PORT=6379