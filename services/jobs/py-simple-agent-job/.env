AGENT_ID=simple-agent
LOG_LEVEL=INFO

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=agent.requests
RABBITMQ_QUEUE=agent.simple.requests
RABBITMQ_ROUTING_KEY=agent.simple
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONNECTION_ATTEMPTS=1
RABBITMQ_RETRY_DELAY=1
RABBITMQ_SOCKET_TIMEOUT=5
RABBITMQ_RECONNECT_DELAY=3

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_RESPONSE_CHANNEL_PREFIX=chat:response

DATABASE_URL=postgresql+asyncpg://postgres_vector:automate123@postgres-vector:5432/postgres_vector_db

CHAT_API_URL=http://localhost:8000/api/v1/messages
CHAT_APPLICATION_ID=chat-cli
CHAT_CHAT_ID=chat-cli-1
CHAT_AGENT_ID=simple-agent
