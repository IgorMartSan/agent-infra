# === Configuração do Agente ===
AGENT_ID=rsa-agent
LOG_LEVEL=INFO

# Heartbeat no Redis (disponibilidade do agente)
AGENT_HEARTBEAT_TTL_SECONDS=30
AGENT_HEARTBEAT_INTERVAL_SECONDS=10

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=agent.requests
RABBITMQ_QUEUE=agent.rsa.requests
RABBITMQ_ROUTING_KEY=agent.rsa
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_RECONNECT_DELAY=3

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_RESPONSE_CHANNEL_PREFIX=chat:response

# === LLM (OpenAI-compatible) ===
OPENAI_BASE_URL=http://10.247.168.43:8072/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=gemma4
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# === MCP Server ===
# Caminho para o main.py do servidor MCP que este agente usa
MCP_SERVER_PATH=../../mcps/py-mcp-infra-test/src/main.py
# Nome lógico do servidor MCP (usado como chave no MultiServerMCPClient)
MCP_SERVER_NAME=rsa-db

# === Agente ===
RSA_AGENT_RECURSION_LIMIT=12