# === Configuração do Agente ===
AGENT_ID=rsa-agent

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === LLM (OpenAI-compatible) ===
OPENAI_BASE_URL=http://127.0.0.1:8072/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=gemma4
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# === MCP Server ===
# Caminho para o main.py do servidor MCP que este agente usa
MCP_SERVER_PATH=/code/services/mcps/py-mcp-rsa/src/main.py
MCP_PYTHON_EXECUTABLE=/code/services/mcps/py-mcp-rsa/.venv/bin/python
# Nome lógico do servidor MCP (usado como chave no MultiServerMCPClient)
MCP_SERVER_NAME=rsa-db

# === Agente ===
AGENT_RECURSION_LIMIT=12
# Resumir mensagens antigas quando o histórico ultrapassar este número.
RSA_MEMORY_MAX_MESSAGES=20
RSA_CHECKPOINT_DATABASE_URL=postgresql://postgres_vector:CHANGE_ME@postgres-vector:5432/postgres_vector_db
