AGENT_ID=sql-agent
LOG_LEVEL=INFO
# Disponibilidade do agente (heartbeat no Redis):
# TTL da chave e intervalo de renovação, em segundos.
AGENT_HEARTBEAT_TTL_SECONDS=30
AGENT_HEARTBEAT_INTERVAL_SECONDS=10

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=agent.requests
RABBITMQ_QUEUE=agent.sql.requests
RABBITMQ_ROUTING_KEY=agent.sql
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONNECTION_ATTEMPTS=1
RABBITMQ_RETRY_DELAY=1
RABBITMQ_SOCKET_TIMEOUT=5
RABBITMQ_RECONNECT_DELAY=3

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_RESPONSE_CHANNEL_PREFIX=chat:response

OPENAI_BASE_URL=http://10.247.168.43:8072/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=gemma4
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

SQL_DATABASE_DRIVER=postgresql+psycopg
SQL_DATABASE_HOST=host-do-banco
SQL_DATABASE_PORT=5432
SQL_DATABASE_NAME=nome_do_banco
SQL_DATABASE_USER=usuario_somente_leitura
SQL_DATABASE_PASSWORD=troque-esta-senha
SQL_DATABASE_SSLMODE=prefer
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_AGENT_RECURSION_LIMIT=12

CHAT_API_URL=http://localhost:8000/api/v1/messages
CHAT_APPLICATION_ID=sql-chat-cli
CHAT_CHAT_ID=sql-chat-1
CHAT_AGENT_ID=sql-agent
