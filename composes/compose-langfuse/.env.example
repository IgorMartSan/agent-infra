# Copie para .env nesta pasta e substitua todos os valores CHANGE_ME.
# Gere segredos aleatórios; ENCRYPTION_KEY deve ter 64 caracteres hexadecimais.
NEXTAUTH_URL=http://localhost:3002
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES@postgres:5432/postgres
SALT=CHANGE_ME_SALT
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE
REDIS_AUTH=CHANGE_ME_REDIS
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME_MINIO
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME_MINIO
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGE_ME_MINIO
