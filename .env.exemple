# Caminho base dos volumes usados pelos docker-compose
PATH_VOLUMES="../volumes"

# Porta usada pelo pgAdmin no compose.postgres.yaml
GLOBAL_PGADMIN_PORT=8081

# ------------------------------------------------------------------------------
# Servico: rabbitmq (compose.rabbitmq.yml)
# Variaveis usadas pelo container RabbitMQ no Docker Compose
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RABBITMQ_DEFAULT_VHOST=agents

# ------------------------------------------------------------------------------
# Servico: redis (compose.redis.yaml)
# Variaveis usadas pelos servicos que dependem de Redis/PubSub
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_RESPONSE_CHANNEL_PREFIX=chat:response
MESSAGE_AGENT_DEFAULT_ID=agent1
CHAT_MAX_PENDING_MESSAGES=10
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_BLOCK_SECONDS=60

# ------------------------------------------------------------------------------
# Servico: postgres-vector (compose.postgres.yaml)
# Variaveis usadas pelo container PostgreSQL no Docker Compose
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_vector
POSTGRES_PASSWORD=automate123
POSTGRES_DB=postgres_vector_db

# ------------------------------------------------------------------------------
# Servico: pgadmin (compose.postgres.yaml)
# Variaveis usadas pelo pgAdmin no Docker Compose
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# Servico: py-message-aggregator-api (compose.services.yaml)
# Variaveis que devem entrar no Docker Compose da API
# ------------------------------------------------------------------------------
API_PORT=8000
API_LOG_DIR=/code/logs
API_SHOW_LOG=true
API_LOG_ERROR_MODE=full
API_RABBITMQ_URL=
API_RABBITMQ_HOST=rabbitmq
API_RABBITMQ_PORT=5672
API_RABBITMQ_USERNAME=admin
API_RABBITMQ_PASSWORD=admin123
API_RABBITMQ_VHOST=agents
API_RABBITMQ_QUEUE=message-aggregator

# ------------------------------------------------------------------------------
# Servico: worker-collector (compose.services.yaml)
# Variaveis que devem entrar no Docker Compose do worker-collector
# ------------------------------------------------------------------------------
COLLECTOR_LOG_DIR=/code/logs
COLLECTOR_SHOW_LOG=true
COLLECTOR_LOG_ERROR_MODE=full
COLLECTOR_RABBITMQ_URL=
COLLECTOR_RABBITMQ_HOST=rabbitmq
COLLECTOR_RABBITMQ_PORT=5672
COLLECTOR_RABBITMQ_USERNAME=admin
COLLECTOR_RABBITMQ_PASSWORD=admin123
COLLECTOR_RABBITMQ_VHOST=agents
COLLECTOR_RABBITMQ_QUEUE=message-aggregator
COLLECTOR_RABBITMQ_PREFETCH_COUNT=20
COLLECTOR_POSTGRES_HOST=postgres-vector
COLLECTOR_POSTGRES_PORT=5432
COLLECTOR_POSTGRES_USER=postgres_vector
COLLECTOR_POSTGRES_PASSWORD=automate123
COLLECTOR_POSTGRES_DB=postgres_vector_db

# ------------------------------------------------------------------------------
# Servico: worker-agent (compose.services.yaml)
# Variaveis que devem entrar no Docker Compose do worker-agent
# ------------------------------------------------------------------------------
AGENT_LOG_DIR=/code/logs
AGENT_SHOW_LOG=true
AGENT_LOG_ERROR_MODE=full
AGENT_POSTGRES_HOST=postgres-vector
AGENT_POSTGRES_PORT=5432
AGENT_POSTGRES_USER=postgres_vector
AGENT_POSTGRES_PASSWORD=automate123
AGENT_POSTGRES_DB=postgres_vector_db
AGENT_REDIS_HOST=redis
AGENT_REDIS_PORT=6379
AGENT_REDIS_DB=0
AGENT_REDIS_RESPONSE_CHANNEL_PREFIX=chat:response
AGENT_POLL_INTERVAL_SECONDS=5
AGENT_BATCH_IDLE_SECONDS=5
AGENT_MAX_MESSAGES_PER_GROUP=10
AGENT_LOCK_TTL_SECONDS=60
AGENT_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Servico: worker-message-simulator (compose.services.yaml)
# Variaveis que devem entrar no Docker Compose do simulador de mensagens
# ------------------------------------------------------------------------------
SIMULATOR_LOG_DIR=/code/logs
SIMULATOR_SHOW_LOG=true
SIMULATOR_LOG_ERROR_MODE=full
SIMULATOR_PUBLISHER_API_URL=http://py-message-aggregator-api:8000/message-aggregator-api/messages
SIMULATOR_CHAT_ID=chat-simulator-1
SIMULATOR_SHORT_DELAY_SECONDS=5
SIMULATOR_LONG_DELAY_SECONDS=15

# ------------------------------------------------------------------------------
# Variaveis legadas/outros servicos do repositorio
# Mantidas aqui porque ja existiam no .env.exemple
# ------------------------------------------------------------------------------
EMBEDDING_API_BASE_URL=http://127.0.0.1:8080
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents
VECTOR_SIZE=768
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_BASE_URL=http://10.247.168.43:11434
EMBEDDING_WARMUP_TEXT=startup warmup
